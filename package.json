{
  "name": "studio-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Studio Hub: el panel de trabajo del estudio para llevar todos sus videojuegos, de la idea a la publicación.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:claude": "tsc -b && vite build --mode artifact && node scripts/empaquetar-claude.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "historial": "node scripts/importar-historial-git.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
